{
  "name": "mostrai",
  "version": "0.1.0",
  "description": "Mostraí - rede de mídia digital indoor (Matão-SP), projeto San & Co.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node src/db/migrate.js",
    "backup": "bash scripts/backup.sh",
    "conciliar": "node scripts/conciliar.js",
    "apurar-banco-horas": "node scripts/apurar-banco-horas.js",
    "sintaxe": "for f in $(git ls-files 'src/**/*.js' 'public/**/*.js' 'tests/*.js'); do node --check \"$f\" || exit 1; done",
    "lint": "biome lint .",
    "lint:corrigir": "biome lint --write .",
    "formato": "biome format .",
    "formato:corrigir": "biome format --write .",
    "check": "npm run sintaxe && npm run lint && npm run formato && npm test",
    "favicon": "node scripts/favicon.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcrypt": "^5.1.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "nodemon": "^3.1.4",
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
