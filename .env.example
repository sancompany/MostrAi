# Mostraí — variáveis de ambiente
# Copie pra .env e preencha. NUNCA commite o .env (está no .gitignore).
# Em produção (Northflank) essas variáveis vão no painel do serviço, não em arquivo.

# --- Banco (Supabase Postgres, projeto próprio do Mostraí; mesma região do serviço) ---
DATABASE_URL=postgres://user:password@db.xxxx.supabase.co:5432/postgres

# --- Sessão e admin ---
# SESSION_SECRET: 32+ bytes aleatórios (ex.: `openssl rand -base64 48`)
SESSION_SECRET=troque_isto
# Segunda camada do /admin — a porta é o Cloudflare Access (CONSTRAINTS.md)
ADMIN_USER=troque_isto
ADMIN_PASSWORD=troque_isto_tambem

# --- Site ---
# URL pública do site: base dos links de convite (/convite.html?t=...) e de
# redefinição de senha. Sem barra no fim.
SITE_URL=https://mostrai.sancocore.com.br
CORS_ORIGIN=https://mostrai.sancocore.com.br
PORT=3000
NODE_ENV=production

# --- Storage dos criativos (Supabase Storage) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=criativos

# --- San Checkout (estrutura San & Co. — skill `checkout`) ---
# NÃO existe segredo separado de webhook. O Checkout assina cada notificação
# com HMAC-SHA256 usando a MESMA SAN_CHECKOUT_KEY abaixo (API.md dele, 4.3.1),
# e é ela que `webhookAutorizado` confere. Sem SAN_CHECKOUT_KEY o webhook
# FALHA FECHADO e recusa tudo.
# O checkout tem DOIS endereços e eles não são intercambiáveis (API.md dele,
# seção 2.1). BASE_URL é a tela que o comprador abre no navegador; API_URL é a
# que o nosso servidor chama. Usar um só deixa um dos dois lados quebrado.
SAN_CHECKOUT_BASE_URL=
SAN_CHECKOUT_API_URL=
SAN_CHECKOUT_CONTRATANTE_ID=
SAN_CHECKOUT_KEY=

# --- E-mail transacional (confirmação de pagamento, redefinição de senha) ---
MOSTRAI_EMAIL_FROM=mostrai@sancocore.com.br
MOSTRAI_EMAIL_CONTATO=mostrai@sancocore.com.br
# Opcional: como o recebedor aparece no comprovante de pagamento em PDF
# (src/financeiro/comprovante.js). Vazio = "Mostraí — San & Co.". Decisão do
# dono enquanto a pessoa jurídica não existe (docs/PENDENCIAS.md, seção M).
MOSTRAI_COMPROVANTE_RECEBEDOR=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Opcional: ritmo dos comunicados do admin (RN-68), em e-mails por minuto
# (1 a 120). Vazio = 30 (um a cada 2 s). Baixe se o provedor reclamar.
# COMUNICADOS_POR_MINUTO=30
# Opcional: teto de mensagens de comunicado em 24 h. Vazio = 300 — bem abaixo
# do limite diário da conta de envio, que é a MESMA dos códigos e senhas.
# COMUNICADOS_MAX_DIA=300
# Só local/e2e: grava cada e-mail como linha JSON neste arquivo em vez de
# mandar (tests/e2e/restart.sh liga sozinho). Ignorado em produção.
# EMAIL_CAPTURA=tests/e2e/saida/emails.jsonl

# --- Backup de nota fiscal no Drive do workspace San & Co. ---
GOOGLE_DRIVE_FOLDER_ID=
# Em produção use GOOGLE_SERVICE_ACCOUNT_KEY com o JSON INTEIRO da conta de
# serviço dentro da variável — este repositório é público e o arquivo de chave
# nunca deve encostar na árvore. O _PATH existe só para rodar local.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# --- Content-Security-Policy ---
# A política é montada em src/server.js e é estrita: nenhum 'unsafe-inline'.
# CSP_REPORT_ONLY=1 sobe ela sem bloquear nada — saída de emergência se algum
# navegador reclamar de algo que não apareceu nos testes. Vazio = bloqueando.
CSP_REPORT_ONLY=

# --- Métrica ---
# Ids de conta que NÃO devem contar como métrica: as suas, de teste. A conta
# própria do Mostraí já é excluída sozinha (conta_propria), não precisa entrar
# aqui. Separe por vírgula. Vazio = só a conta própria é interna.
EVENTOS_CONTAS_INTERNAS=

# --- Trimundi (ticketeira — projeto próprio hospedado aqui, ADR-048) ---
# Banco PRÓPRIO da Trimundi, nunca o da Mostraí (o servidor recusa se as duas
# URLs apontarem para o mesmo banco). Vazio = módulo desligado: /ticket/*
# responde 503 e o login da Mostraí não procura operador. Migrations:
# `npm run trimundi:migrate` (em produção só com --producao-autorizada).
TRIMUNDI_DATABASE_URL=
# Segredo-mestre (32+ caracteres): deriva as chaves do QR, dos códigos de
# ativação e do simulador. Obrigatório em produção; fora dela, sem ele, deriva
# do SESSION_SECRET. Trocar invalida todos os QR já emitidos.
TRIMUNDI_SEGREDO=
# San Checkout: a Trimundi é contratante PRÓPRIO (chave e webhook dela, nunca
# os da Mostraí). Webhook: {SITE_URL}/ticket/api/checkout/webhook; endereço do
# pedido: {SITE_URL}/ticket/api/checkout/pedido/{pedidoId}.
TRIMUNDI_CHECKOUT_BASE_URL=
TRIMUNDI_CHECKOUT_API_URL=
TRIMUNDI_CHECKOUT_CONTRATANTE_ID=
TRIMUNDI_CHECKOUT_KEY=
# Só desenvolvimento: 1 liga o pagamento simulado (tela /ticket/dev/pagamento).
# Ignorado com NODE_ENV=production.
TRIMUNDI_PAGAMENTO_SIMULADO=
# Imagens da edição: Storage do projeto Supabase PRÓPRIO da Trimundi. Em
# desenvolvimento, TRIMUNDI_ARMAZENAMENTO=local grava em disco
# (TRIMUNDI_ARMAZENAMENTO_PASTA, padrão .trimundi-arquivos).
TRIMUNDI_ARMAZENAMENTO=
TRIMUNDI_ARMAZENAMENTO_PASTA=
TRIMUNDI_SUPABASE_URL=
TRIMUNDI_SUPABASE_SERVICE_ROLE_KEY=
TRIMUNDI_STORAGE_BUCKET=
# E-mail próprio da Trimundi. Sem provedor, a mensagem fica guardada
# ("aguardando provedor") — nunca finge que saiu. Em desenvolvimento,
# TRIMUNDI_EMAIL_CAPTURA grava as mensagens num arquivo .jsonl em vez de enviar.
TRIMUNDI_EMAIL_FROM=
TRIMUNDI_SMTP_HOST=
TRIMUNDI_SMTP_PORT=
TRIMUNDI_SMTP_USER=
TRIMUNDI_SMTP_PASS=
TRIMUNDI_EMAIL_CAPTURA=
